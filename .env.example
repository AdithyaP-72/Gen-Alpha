# WorldQuant BRAIN credentials — used for programmatic login (POST /authentication).
# Never commit the real .env; this file is the template.
WQ_BRAIN_USERNAME=your.email@example.com
WQ_BRAIN_PASSWORD=your_password

# Manual fallback if you can't use username/password: paste the Cookie header
# value from a logged-in browser session (expires ~24h).
# WQ_SESSION_COOKIE=t=eyJ0...

# Groq API keys — round-robin rotation across however many you provide (1–9).
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Backend server
API_PORT=5001
# Set to 1 only for local Flask debugging — never in anything reachable from a network.
FLASK_DEBUG=0

# ── Storage locations (all optional; defaults shown) ──
# SQLite experiment store — candidates, runs, papers, LLM interactions
ALPHA_DB_PATH=runtime/alpha_lab.db
# Tracked reference data + result exports
GENALPHA_DATA_DIR=data
# Gitignored runtime state: logs, caches, models, pipeline state
GENALPHA_RUNTIME_DIR=runtime
